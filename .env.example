# Copie para GarimpoInvestimentos/.env e preencha APENAS no arquivo local.
# Nunca versione o .env e nunca cole chaves em logs, issues ou chat.

# --- LLM ---
LLM_PROVIDER=gemini
LLM_MULTI_PROVIDERS=gemini,groq,cerebras,mistral
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Noticias ---
NEWS_PROVIDERS=serpapi
NEWS_FALLBACK_PROVIDER=
SERP_API_KEY=
CRYPTOPANIC_AUTH_TOKEN=
NEWSAPIAI_API_KEY=
MEDIASTACK_API_KEY=

# --- Dados de mercado ---
COINGECKO_API_KEY=

# --- Coleta e guardas ---
LIMIAR_SCORE_MINIMO=60
DEFAULT_ASSETS=bitcoin,ethereum,solana
CACHE_TTL_HOURS=6
ENABLE_CACHE=true
SCORE_HORIZON_DAYS=7
LLM_PACING_SECONDS=7
LLM_ENSEMBLE_N=1

# Controles opt-in: alteram a populacao/coleta e exigem nova trial forward.
LLM_PREFILTER_ENABLED=false
LLM_PREFILTER_MIN_VOLUME_USD=10000000
LLM_PREFILTER_MIN_ABS_CHANGE_7D=2
# API_GUARD_ENABLED=true e o default (fail-closed, auditoria 2026-08-28/V-02).
# ATENCAO: com os limites abaixo em 0, a guarda fica ligada mas sem teto
# (nenhum orcamento e de fato aplicado). Defina os 3 limites abaixo com um
# valor > 0 para que o guard passe a bloquear de verdade. Ver docs/API_GUARDS.md.
API_GUARD_ENABLED=true
API_GUARD_MAX_INGEST_ASSETS=0
API_GUARD_MAX_NEWS_ATTEMPTS_PER_PROVIDER=0
API_GUARD_MAX_LLM_CALLS_PER_PROVIDER=0
