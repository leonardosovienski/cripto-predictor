# GarimpoInvestimentos — TEMPLATE de credenciais.
# 1. Copie para `.env` (mesma pasta):   copy .env.example .env
# 2. Preencha GEMINI_API_KEY e SERP_API_KEY com chaves REAIS (>=16 chars).
# ⚠️ A trava P0 (config.py) CRASHA no import se a chave estiver ausente, for um
#    placeholder conhecido, ou tiver <16 chars. O .env NÃO é versionado (gitignore).
#
# Gemini:  https://aistudio.google.com/app/apikey
# SerpAPI: https://serpapi.com/manage-api-key
# CoinGecko (mercado): free tier, NÃO exige chave.

# Provedor de LLM: "gemini" (default) ou "openai"
LLM_PROVIDER=gemini

# Obrigatória se LLM_PROVIDER=gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ⚠️ alias FLUTUANTE — pine um snapshot datado (ex.: gemini-2.5-flash-001) para a
#    judge_signature não derivar silenciosamente no meio de uma janela de coleta.

# Obrigatórias só se LLM_PROVIDER=openai (API paga, NÃO é o ChatGPT Plus):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sempre obrigatória (notícias):
SERP_API_KEY=

# Pipeline (têm default; sobrescreva se quiser):
LIMIAR_SCORE_MINIMO=60
DEFAULT_ASSETS=bitcoin,ethereum,solana,binancecoin,ripple,cardano,dogecoin,tron,avalanche-2,chainlink,polkadot,litecoin,bitcoin-cash,stellar,uniswap,cosmos,monero,aave,near,algorand,vechain,filecoin
CACHE_TTL_HOURS=6
ENABLE_CACHE=true
SCORE_HORIZON_DAYS=7
