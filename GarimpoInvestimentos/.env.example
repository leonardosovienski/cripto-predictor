# Copie para GarimpoInvestimentos/.env e preencha APENAS no arquivo local.
# Nunca versione o .env e nunca cole chaves em logs, issues ou chat.

# --- LLM ---
# Se LLM_PROVIDER=multi, preencha as chaves de todos os nomes em
# LLM_MULTI_PROVIDERS. O padrao abaixo preserva a configuracao existente.
LLM_PROVIDER=gemini
LLM_MULTI_PROVIDERS=gemini,groq,cerebras,mistral
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Noticias ---
# O padrao mantem a H5 sem alteracao. NAO habilite fontes novas na H5;
# use somente em uma nova trial forward, apos o fechamento humano de seguranca.
NEWS_PROVIDERS=serpapi
# Para uma NOVA trial com cinco fontes distribuidas e SerpAPI somente como
# fallback, substitua as duas linhas acima por estas (e preencha todas as chaves):
# NEWS_PROVIDERS=cryptopanic,newsapi_ai,mediastack,google_news_rss,curated_rss
# NEWS_FALLBACK_PROVIDER=serpapi
NEWS_FALLBACK_PROVIDER=
SERP_API_KEY=
CRYPTOPANIC_AUTH_TOKEN=
# NewsAPI.ai / Event Registry. NEWSAPI_AI_API_KEY e aceito como alias, mas use
# preferencialmente o nome abaixo para manter uma unica convencao.
NEWSAPIAI_API_KEY=
# Mediastack
MEDIASTACK_API_KEY=

# --- Dados de mercado ---
COINGECKO_API_KEY=

# --- Coleta e guardas ---
LIMIAR_SCORE_MINIMO=60
DEFAULT_ASSETS=bitcoin,ethereum,solana
CACHE_TTL_HOURS=6
ENABLE_CACHE=true
SCORE_HORIZON_DAYS=7
LLM_PACING_SECONDS=7

# Estes controles sao opt-in e alteram a populacao/coleta. Mantenha desligados
# ate abrir uma nova trial forward documentada.
LLM_PREFILTER_ENABLED=false
LLM_PREFILTER_MIN_VOLUME_USD=10000000
LLM_PREFILTER_MIN_ABS_CHANGE_7D=2
API_GUARD_ENABLED=false
API_GUARD_MAX_INGEST_ASSETS=0
API_GUARD_MAX_NEWS_ATTEMPTS_PER_PROVIDER=0
API_GUARD_MAX_LLM_CALLS_PER_PROVIDER=0


